[TR_RockClimb_Ability X2AbilityTemplate]
LocFriendlyName="Rock Climb"
LocLongDescription="Allows the user to scale vertical surfaces quickly. The ability has a recharge time of <font color='#3ABD23'><Ability:TR_RockClimb_Cooldown_Ability/></font> turns. Each use costs <font color='#3ABD23'><Ability:TR_RockClimb_AP_Cost_Ability/></font> action points."
LocHelpText="Allows the user to scale vertical surfaces quickly."
LocPromotionPopupText="<Bullet/></font> Climb walls"
LocFlyOverText="Rock Climb"

[TR_RockClimb_Item X2AbilityTemplate]
LocFriendlyName="Rock Climbing Gear"
LocLongDescription="This armour allows the user to scale vertical surfaces quickly. Can be used <font color='#3ABD23'><Ability:TR_RockClimb_InitialCharge_Item/></font> times per mission, with a recharge time of <font color='#3ABD23'><Ability:TR_RockClimb_Cooldown_Item/></font> turns. Each use costs <font color='#3ABD23'><Ability:TR_RockClimb_AP_Cost_Item/></font> action points."
LocHelpText="Allows the user to scale vertical surfaces quickly."
LocPromotionPopupText="<Bullet/></font> Climb walls"
LocFlyOverText="Rock Climbing Gear"

[TR_RockClimb_Item_Armour X2AbilityTemplate]
