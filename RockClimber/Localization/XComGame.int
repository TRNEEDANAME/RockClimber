LocLongDescription="This armour allows the user to scale vertical surfaces quickly. Works indefinitely."
LocHelpText="Allows the user to scale vertical surfaces quickly."
LocPromotionPopupText="<Bullet/></font> Climb walls"
LocFlyOverText="Rock Climbing armour"

[TR_RockClimb_Item_Vest X2AbilityTemplate]
