[TR_RockClimb_Ability X2AbilityTemplate]
LocFriendlyName="Rock Climb"
LocLongDescription="Allows the user to scale vertical surfaces quickly. <Ability:TR_RockClimbAbility_HasCharge> a recharge time of <Ability:TR_RockClimb_Cooldown_Ability/> turns. Each use costs <Ability:TR_RockClimb_AP_Cost_Ability/> action points."
LocHelpText="Allows the user to scale vertical surfaces quickly."
LocPromotionPopupText="<Bullet/> Climb walls"
LocFlyOverText="Rock Climb"

[TR_RockClimb_Item X2AbilityTemplate]
LocFriendlyName="Rock Climbing Gear"
LocLongDescription="This gear allows the user to scale vertical surfaces quickly. <Ability:TR_RockClimbItem_HasCharge> a recharge time of <Ability:TR_RockClimb_Cooldown_Item/> turns. Each use costs <Ability:TR_RockClimb_AP_Cost_Item/> action points."
LocHelpText="Allows the user to scale vertical surfaces quickly."
LocPromotionPopupText="<Bullet/> Climb walls"
LocFlyOverText="Rock Climbing Gear"

[TR_RockClimb_Item_Armour X2AbilityTemplate]
